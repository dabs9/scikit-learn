# Review-harness run configuration (PR scikit-learn/scikit-learn#26385)
PR_NUMBER=26385
BASE_SHA=86541f2b3bc8a96264e265cb810cf79858544340
HEAD_SHA=04c8b6954e3e4b8f8af086cea9d386f954b76bfe
# 12 themes (prompts/themes.tsv) x 3 blind waves = 36 draw seats, 12 concurrent per wave
DRAW_WAVES="a b c"
REVIEW_MODEL="${REVIEW_MODEL:-claude-opus-4-8}"
# Forced thinking budget. Empty = model's adaptive default (required by API
# endpoints where legacy thinking.enabled is unsupported, e.g. opus-4-7 on the
# Anthropic API; Bedrock-side serving accepts the forced budget).
MAX_THINKING_TOKENS="${MAX_THINKING_TOKENS-31999}"
UPSTREAM_URL=https://github.com/scikit-learn/scikit-learn.git
# RUN_LABEL names the output dir runs/<RUN_LABEL>; override for benchmark runs
# (e.g. RUN_LABEL=26385-local) so runs never collide.
RUN_LABEL="${RUN_LABEL:-$PR_NUMBER}"
